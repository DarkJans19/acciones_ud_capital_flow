APP_NAME=Acciones UD API
APP_ENV=development

# Copiar host, usuario y contraseña desde "Connect" en Supabase. Para un backend
# persistente usar conexión directa cuando haya IPv6 o Session pooler en redes IPv4.
# asyncpg utiliza "ssl=require"; "sslmode=require" corresponde a otros drivers.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?ssl=require

# Alembic debe usar preferiblemente la conexión directa. Si el entorno no tiene
# IPv6, usar aquí el Session pooler de puerto 5432.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?ssl=require
