APP_NAME=Acciones UD API
APP_ENV=development

# Copiar host, usuario y contraseña desde "Connect" en Supabase. Para un backend
# persistente usar conexión directa cuando haya IPv6 o Session pooler en redes IPv4.
# asyncpg utiliza "ssl=require"; "sslmode=require" corresponde a otros drivers.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?ssl=require


SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Existing environment compatibility; prefer DATABASE_URL and a separate migration URL.
DATABASE_CONNECTION=

# Alembic debe usar preferiblemente la conexión directa. Si el entorno no tiene
# IPv6, usar aquí el Session pooler de puerto 5432.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?ssl=require

CLIENT_ID=
CLIENT_SECRET=
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_AUTH_URL=https://authx.sandbox.alpaca.markets

# Backend API configuration (values are examples; inject through process environment).
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.sandbox.alpaca.markets
ALPACA_STREAM_BASE_URL=wss://stream.data.sandbox.alpaca.markets
ALPACA_DATA_FEED=iex
PRICE_STALENESS_THRESHOLD_SECONDS=900
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173
TOTP_ENCRYPTION_KEY=
PRICE_STREAMING_ENABLED=false
ALERT_ENGINE_ENABLED=true
ALERT_EVALUATION_INTERVAL_SECONDS=60
MARKET_CLOCK_CHECK_INTERVAL_SECONDS=60
CATALOG_MAX_AGE_HOURS=24
DASHBOARD_DEFAULT_SYMBOLS=AAPL,MSFT,AMZN,GOOGL,META,NVDA,TSLA,JPM,V,KO
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO

# Migration-only: precompute the password hash; never put a plaintext password here.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD_HASH=
INITIAL_ADMIN_FIRST_NAMES=Initial
INITIAL_ADMIN_LAST_NAMES=Administrator
INITIAL_ADMIN_PHONE=+573001234567
INITIAL_ADMIN_COUNTRY=CO

# Disposable PostgreSQL only; never use the shared development database.
TEST_DATABASE_URL=
